subscription_id = "00000000-0000-0000-0000-000000000000"
location         = "centralus"
environment_name = "prod"

# Required: replace this deliberately invalid value with an HTTPS origin on a
# public DNS hostname you own. Do not include a port, path, or trailing slash.
public_base_url = "https://patchpage.your-domain.invalid"

# Safe default: forwarding headers remain untrusted. Set only after completing
# the trusted-proxy HITL verification in README.md.
trust_proxy = null

# Persistent-data recovery defaults. Geo-redundant replication and the
# retention windows can be adjusted within the validated values.
storage_replication_type       = "GRS"
storage_delete_retention_days  = 30
postgres_backup_retention_days = 35

# Application safety defaults. These match the server defaults and may be
# lowered or raised within the documented validation bounds.
allow_anonymous_uploads                         = false
max_html_bytes                                  = 524288
protected_api_rate_limit_per_minute            = 60
authenticated_upload_rate_limit_per_minute     = 20
anonymous_create_rate_limit_per_minute         = 5

# Fill after the first ACR build:
# server_image = "acrpatchpageabc123.azurecr.io/patchpage-server@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
