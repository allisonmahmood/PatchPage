subscription_id = "00000000-0000-0000-0000-000000000000"
location         = "centralus"
environment_name = "prod"

# Required: replace this deliberately invalid value with an HTTPS origin on a
# public DNS hostname you own. Do not include a port, path, or trailing slash.
public_base_url = "https://patchpage.your-domain.invalid"

# Safe default: forwarding headers remain untrusted. Set only after completing
# the trusted-proxy HITL verification in README.md.
trust_proxy = null

# Persistent-data recovery defaults. Replication and the retention windows can
# be adjusted within the validated values. LRS is the cost-posture default;
# raising it to a geo-redundant type is a deliberate durability purchase.
storage_replication_type       = "LRS"
storage_delete_retention_days  = 30
postgres_backup_retention_days = 35

# Cost posture. See "Cost posture, the circuit breaker, and the kill switch" in
# README.md before changing any of these; the defaults are the public
# instance's ratified posture rather than tuning knobs.
#
# budget_start_date must be the first of the month you apply in: Azure rejects a
# start date that is not the first of a month, and rejects one too far in the
# past when the budget is first created. The default here will go stale.
monthly_circuit_breaker_amount      = 200
monthly_cost_target_amount = 100
budget_start_date          = "2026-08-01T00:00:00Z"

# 100 GiB/day of Container App egress fires the kill switch. 50 GiB of total
# blob storage only notifies.
egress_tripwire_bytes_per_day = 107374182400
blob_capacity_alarm_bytes     = 53687091200

# Set this. Without it the kill switch still fires -- it does not depend on
# anyone reading mail -- but nothing tells you that it did.
operator_alert_email = null

# Azure caps Automation webhook lifetime at ten years. Past this date both
# triggers still fire and the runbook still exists, but nothing invokes it.
kill_switch_webhook_expiry = "2036-01-01T00:00:00Z"

# The runbook needs Az.Accounts for Connect-AzAccount and Invoke-AzRestMethod.
# It is imported explicitly at this exact version rather than inherited from the
# Automation account's defaults, so a missing module fails at apply instead of
# during an incident. Bump deliberately when it ages out of support.
kill_switch_az_accounts_version = "5.5.2"

# Application safety defaults. These match the server defaults and may be
# lowered or raised within the documented validation bounds.
allow_self_service_tokens                      = false
max_html_bytes                                 = 524288
protected_api_rate_limit_per_minute            = 60
authenticated_upload_rate_limit_per_minute     = 20
self_service_mint_rate_limit_per_minute        = 5
draft_create_rate_limit_per_minute             = 10
report_rate_limit_per_minute                   = 10
live_drafts_per_token                          = 1000

# Fill after the first ACR build:
# server_image = "acrpatchpageabc123.azurecr.io/patchpage-server@sha256:0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
