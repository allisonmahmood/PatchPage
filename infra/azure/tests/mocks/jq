#!/bin/sh
# jq shim for the guide harness. Reached only through PATH.
#
# One injection, shared by both Terraform flows: the second read of the saved
# plan's JSON rendering fails, so the block has to report that it could not
# render the action summary. The plan JSON sits inside the secure plan directory
# the block got from mktemp, so the path is recovered from the mktemp shim's
# recording by the template that created it. Every other invocation -- including
# the smoke flow's real JSON assertions in the curl shim -- falls through to the
# real jq.

set -u

. "${PP_MOCK_DIR:-${0%/*}}/mocklib.sh"

jq_plan_json=''
case "$group" in
  deploy)
    jq_plan_dir="$(
      mock_mktemp_recall \
        "-d $TERRAFORM_DIAGNOSTIC_ROOT/patchpage-initial-plan.XXXXXX"
    )"
    test -z "$jq_plan_dir" || jq_plan_json="$jq_plan_dir/initial.json"
    jq_seen_name="initial-plan-jq-seen"
    ;;
  infrastructure)
    jq_plan_dir="$(
      mock_mktemp_recall \
        "-d $TERRAFORM_DIAGNOSTIC_ROOT/patchpage-infrastructure-change.XXXXXX"
    )"
    test -z "$jq_plan_dir" || jq_plan_json="$jq_plan_dir/infrastructure-plan.json"
    jq_seen_name="infrastructure-plan-jq-seen"
    ;;
esac

if test -n "$jq_plan_json" && test "$(mock_last_arg "$@")" = "$jq_plan_json"; then
  if test "$scenario" = "plan_summary_failure" && mock_state_exists "$jq_seen_name"; then
    exit 1
  fi
  mock_state_mark "$jq_seen_name"
fi

mock_real jq "$@"
