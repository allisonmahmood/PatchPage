{
  "name": "patchpage-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "test:packed-cli-e2e": "node scripts/packed-cli-e2e.mjs",
    "test:public-surfaces": "node scripts/public-surface-contract.test.mjs",
    "test:release-workflow": "node scripts/verify-release-workflow.mjs",
    "test:release-privacy": "node --test scripts/verify-release-privacy.test.mjs",
    "test:exact-npm-publisher": "node --test scripts/publish-exact-npm-artifact.test.mjs",
    "test:ghcr-oci": "node scripts/ghcr-oci-release.test.mjs",
    "test:docker-save": "node scripts/validate-docker-save-artifact.test.mjs",
    "test:server-image": "bash scripts/verify-server-image.sh",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:migrate": "turbo run db:migrate",
    "docker": "turbo run docker",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "esbuild": "0.28.2",
    "eslint": "^10.9.0",
    "npm": "12.0.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "turbo": "^2.10.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "yaml": "2.9.0"
  }
}
